# Copy this file to .env and replace every CHANGE_ME value for local development.
# Never use these placeholders as production credentials.

POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DATABASE_PASSWORD
DATABASE_URL=jdbc:postgresql://localhost:5432/portfolio
DATABASE_USERNAME=portfolio
DATABASE_PASSWORD=CHANGE_ME_LOCAL_DATABASE_PASSWORD

JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ISSUER=ym-pf
JWT_AUDIENCE=ym-pf-admin
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P7D
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
ADMIN_EMAIL=
ADMIN_PASSWORD=

MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_LOCAL_PATH=./data/media
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_REGION=
MEDIA_STORAGE_ENDPOINT=
MEDIA_STORAGE_ACCESS_KEY=
MEDIA_STORAGE_SECRET_KEY=
RESUME_PDF_FONT_PATH=

API_PROXY_TARGET=http://backend:8080
ALLOWED_ORIGINS=http://localhost:3000
